# One deployment's settings, for deploying from your machine (copy to deploy.env, which is gitignored).
# The GitHub workflow takes the same names as repository secrets and variables. docs/self-hosting.md.

# Required: your Cloudflare account (dashboard → Workers & Pages → Account ID).
CLOUDFLARE_ACCOUNT_ID=

# The D1 database. Leave the id empty and run `node scripts/deploy-config.mjs --provision` once:
# it finds or creates the database by name and prints nothing secret.
D1_DATABASE_NAME=fielder-db
D1_DATABASE_ID=
# The R2 bucket for the photos (created by --provision when missing).
R2_BUCKET=fielder-shots

# Worker names; they become <name>.<your-subdomain>.workers.dev.
APP_WORKER_NAME=fielder-api
ADMIN_WORKER_NAME=fielder-admin
# The app's address, for the phone builds (scripts/apk-local.sh) and `make init`.
APP_URL=

# The admin plane's Cloudflare Access application: your Zero Trust team domain and its AUD.
# Until both are set the admin plane refuses every request.
ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=

# Optional. Lower it on the Workers free plan if sign-in fails on CPU time (docs/known-issues.md).
PBKDF2_ITERATIONS=
