  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/atkinson-hyperlegible-next": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@fielder/fov-math": "workspace:*",
    "@fielder/vocab": "workspace:*",
    "expo": "~57.0.0",
    "expo-crypto": "~57.0.0",
    "expo-dev-client": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.0",
    "expo-keep-awake": "~57.0.1",
    "expo-location": "~57.0.0",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "~57.0.3",
    "expo-sqlite": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-webview": "^13.16.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --go --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p .",
    "build:apk": "eas build --platform android --profile apk",
    "start:lan": "expo start --go",
    "build:dev-client": "eas build --platform android --profile dev-client",
    "build:apk:local": "eas build --local --platform android --profile apk --output ../../../fielder-builds/fielder-$(git rev-parse --short HEAD).apk"
