{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The admin plane (epic #107, issue #116): user management on its own hostname, behind its own
  // Cloudflare Access application. Its operators are not app users. Same D1 and R2 as the app.
  // Local development; a deployment gets wrangler.deploy.jsonc with its own settings
  // (scripts/deploy-config.mjs, docs/self-hosting.md).
  "name": "openclapper-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "observability": { "enabled": true },
  // Daily: keep yesterday's Cloudflare analytics beyond the API's window (cloudflare.ts; only with a token).
  "triggers": { "crons": ["47 3 * * *"] },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The Zero Trust team domain and the admin Access application's AUD (not secrets: both are in the
    // login redirect). Set per deployment; empty, every request is refused (locally: ADMIN_DEV_BYPASS).
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "r2_buckets": [
    { "binding": "SHOTS_BUCKET", "bucket_name": "openclapper-media" }
  ],
  // The app's database. Migrations belong to apps/worker; the admin plane never runs them.
  "d1_databases": [
    { "binding": "DB", "database_name": "openclapper-db", "database_id": "00000000-0000-0000-0000-000000000000" }
  ]
}
