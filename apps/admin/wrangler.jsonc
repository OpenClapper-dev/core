{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The admin plane (epic #107, issue #116): user management on its own hostname, behind its own
  // Cloudflare Access application. Its operators are not app users. Same D1 and R2 as the app.
  "name": "fielder-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "account_id": "3868cbc17be171c90972dd32e41e7783",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    // The Zero Trust team, and the AUD of the admin Access application (not secrets: both are in the
    // login redirect). Until the AUD is set every request is refused.
    "ACCESS_TEAM_DOMAIN": "weathered-salad-6072.cloudflareaccess.com",
    "ACCESS_AUD": "set-to-the-admin-access-application-aud"
  },
  "r2_buckets": [
    { "binding": "SHOTS_BUCKET", "bucket_name": "fielder-shots" }
  ],
  // The app's database. Migrations belong to apps/worker; the admin plane never runs them.
  "d1_databases": [
    { "binding": "DB", "database_name": "fielder-db", "database_id": "b12cf742-e055-4f75-aa01-0cf73e36dc63" }
  ]
}
