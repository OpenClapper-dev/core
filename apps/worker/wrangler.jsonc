{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Local development. A deployment gets its own copy, wrangler.deploy.jsonc, with its account
  // and database (scripts/deploy-config.mjs, docs/self-hosting.md).
  "name": "fielder-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-04",
  "observability": { "enabled": true },
  // The auth seam (src/authn/provider.ts): another build points this at its own provider module.
  "alias": { "@fielder/auth-provider": "./src/authn/first-party.ts" },
  // Daily at 03:17 UTC: purge what has been in the recycle bin for 30 days (trash.ts).
  "triggers": { "crons": ["17 3 * * *"] },
  // Web dashboard (apps/dashboard) served as static assets from the same hostname, so the
  // session cookie covers both UI and API.
  "assets": {
    "directory": "../dashboard/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  },
  "r2_buckets": [
    { "binding": "SHOTS_BUCKET", "bucket_name": "fielder-shots" }
  ],
  // Live layout preview (issue #50): one room per user relays the edited layout to the phone.
  "durable_objects": {
    "bindings": [{ "name": "PREVIEW", "class_name": "PreviewRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PreviewRoom"] }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fielder-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
