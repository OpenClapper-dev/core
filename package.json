{
  "name": "fielder",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @fielder/worker --filter @fielder/dashboard dev",
    "dev:init": "bash scripts/dev-init.sh",
    "dev:worker": "pnpm -C apps/worker dev",
    "dev:seed": "node scripts/seed-local.mjs",
    "dev:dashboard": "pnpm -C apps/dashboard dev",
    "dev:mobile": "bash scripts/mobile.sh",
    "wrangler": "wrangler"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "eas-cli": "^23.0.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
