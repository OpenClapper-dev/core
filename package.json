{
  "name": "openclapper",
  "private": true,
  "version": "0.8.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.23 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @openclapper/worker --filter @openclapper/studio dev",
    "dev:init": "bash scripts/dev-init.sh",
    "dev:worker": "pnpm -C apps/worker dev",
    "dev:seed": "node scripts/seed-local.mjs",
    "dev:studio": "pnpm -C apps/studio dev",
    "dev:mobile": "bash scripts/mobile.sh",
    "wrangler": "wrangler",
    "dev:admin": "pnpm -C apps/admin dev",
    "lint": "oxlint",
    "typecheck": "bash scripts/typecheck.sh",
    "test": "pnpm -C packages/vocab test && pnpm -C packages/fov-math test && pnpm -C apps/worker test && pnpm -C apps/admin test && pnpm -C apps/studio test && pnpm -C apps/mobile test",
    "build": "bash scripts/build-check.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2",
    "wrangler": "4.150.0"
  }
}
