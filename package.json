{
  "name": "fielder",
  "private": true,
  "version": "0.5.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @fielder/worker --filter @fielder/studio dev",
    "dev:init": "bash scripts/dev-init.sh",
    "dev:worker": "pnpm -C apps/worker dev",
    "dev:seed": "node scripts/seed-local.mjs",
    "dev:studio": "pnpm -C apps/studio dev",
    "dev:mobile": "bash scripts/mobile.sh",
    "wrangler": "wrangler",
    "dev:admin": "pnpm -C apps/admin dev"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.127.1"
  }
}
